# ADBC driver manifest for Hardcharger: `driver = "hardcharger"` in any ADBC driver manager
# (C/C++, Go, R, Rust, Python).
#
# Replace @PREFIX@ with the directory holding libadbc_driver_hardcharger (from a release tarball,
# or the adbc-driver-hardcharger wheel) and @VERSION@ with its version, then install it as
# `hardcharger.toml` into
#   Linux:   ~/.config/adbc/drivers/
#   macOS:   ~/Library/Application Support/ADBC/Drivers/
#   Windows: %LOCALAPPDATA%\ADBC\Drivers\
# or a directory on ADBC_DRIVER_PATH. With the Python package installed,
# `python -m adbc_driver_hardcharger.manifest` writes it with the path filled in.
#
# The library reads hardcharger:// URIs (HTTPS; ?tls=false for plain HTTP; port 31337 unless
# given) and the adbc.hardcharger.* options itself.

manifest_version = 1

name = 'Hardcharger'
version = '@VERSION@'
publisher = 'GizmoData'
license = 'Apache-2.0'
url = 'https://github.com/gizmodata/hardcharger-adbc'

[ADBC]
version = '1.1.0'

[Driver]
entrypoint = 'AdbcDriverHardchargerInit'

[Driver.shared]
linux_amd64 = '@PREFIX@/libadbc_driver_hardcharger.so'
linux_arm64 = '@PREFIX@/libadbc_driver_hardcharger.so'
macos_amd64 = '@PREFIX@/libadbc_driver_hardcharger.dylib'
macos_arm64 = '@PREFIX@/libadbc_driver_hardcharger.dylib'
windows_amd64 = '@PREFIX@\\libadbc_driver_hardcharger.dll'
windows_arm64 = '@PREFIX@\\libadbc_driver_hardcharger.dll'
